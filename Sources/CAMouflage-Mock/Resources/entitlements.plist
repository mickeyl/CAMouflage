<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Passthrough opens a real AVCaptureSession. Under the Hardened Runtime
         (Developer ID / notarized release builds) camera access is blocked
         without this entitlement, regardless of NSCameraUsageDescription. -->
    <key>com.apple.security.device.camera</key>
    <true/>
</dict>
</plist>
